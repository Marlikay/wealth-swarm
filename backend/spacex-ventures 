  <div class="hero-content">
    <p class="hero-eyebrow">⚡ The Future is Now — Join the Revolution</p>
    <h1 class="hero-title">Welcome to<br>Space X Venture's</h1>
    <p class="hero-sub">Innovation. <span>Mobility.</span> Investment.</p>
    <div class="hero-btns">
      <a href="#vehicles" class="btn-primary">⚡ Explore Vehicles</a>
      <a href="#invest" class="btn-red">📈 Investment Plans</a>
      <a href="#" class="btn-outline" onclick="openModal()">🚀 Join Platform</a>
