<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Space X Venture's – Innovation. Mobility. Investment.</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;700;900&family=Rajdhani:wght@300;400;500;600;700&family=Inter:wght@300;400;500&display=swap" rel="stylesheet"/>
<style>
  :root {
    --bg-deep: #020408;
    --bg-dark: #060c14;
    --bg-card: rgba(8,18,32,0.85);
    --neon-blue: #00c8ff;
    --neon-red: #ff2244;
    --neon-blue-dim: rgba(0,200,255,0.15);
    --neon-red-dim: rgba(255,34,68,0.15);
    --text-primary: #f0f4ff;
    --text-secondary: #8ab0cc;
    --text-dim: #3a5070;
    --gold: #c9a84c;
    --glass: rgba(10,25,45,0.7);
    --glass-border: rgba(0,200,255,0.18);
    --radius: 16px;
    --font-display: 'Orbitron', sans-serif;
    --font-body: 'Rajdhani', sans-serif;
    --font-sub: 'Inter', sans-serif;
  }
  *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{
    background:var(--bg-deep);
    color:var(--text-primary);
    font-family:var(--font-body);
    overflow-x:hidden;
    min-height:100vh;
  }

  /* SCROLLBAR */
  ::-webkit-scrollbar{width:4px}
  ::-webkit-scrollbar-track{background:var(--bg-deep)}
  ::-webkit-scrollbar-thumb{background:var(--neon-blue);border-radius:4px}

  /* NOISE OVERLAY */
  body::before{
    content:'';position:fixed;inset:0;
    background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.03'/%3E%3C/svg%3E");
    pointer-events:none;z-index:0;opacity:0.4;
  }

  /* ===== NAV ===== */
  nav{
    position:fixed;top:0;left:0;right:0;z-index:1000;
    display:flex;align-items:center;justify-content:space-between;
    padding:16px 48px;
    background:rgba(2,4,8,0.75);
    backdrop-filter:blur(20px);
    border-bottom:1px solid rgba(0,200,255,0.1);
  }
  .logo{
    display:flex;align-items:center;gap:12px;
    text-decoration:none;
  }
  .logo-svg{width:46px;height:46px}
  .logo-text{
    font-family:var(--font-display);
    font-size:1.1rem;
    font-weight:700;
    letter-spacing:2px;
    color:var(--text-primary);
    line-height:1.1;
  }
  .logo-text span{color:var(--neon-blue)}
  .nav-links{
    display:flex;align-items:center;gap:32px;
    list-style:none;
  }
  .nav-links a{
    font-family:var(--font-body);
    font-size:0.9rem;
    font-weight:500;
    letter-spacing:1.5px;
    text-transform:uppercase;
    color:var(--text-secondary);
    text-decoration:none;
    transition:color 0.3s;
  }
  .nav-links a:hover{color:var(--neon-blue);text-shadow:0 0 12px var(--neon-blue)}
  .nav-cta{
    background:transparent;
    border:1px solid var(--neon-blue);
    color:var(--neon-blue);
    padding:10px 24px;
    font-family:var(--font-display);
    font-size:0.72rem;
    font-weight:600;
    letter-spacing:2px;
    text-transform:uppercase;
    cursor:pointer;
    border-radius:4px;
    transition:all 0.3s;
    text-decoration:none;
  }
  .nav-cta:hover{background:var(--neon-blue);color:#000;box-shadow:0 0 24px var(--neon-blue)}
  .hamburger{display:none;flex-direction:column;gap:5px;cursor:pointer;padding:4px}
  .hamburger span{display:block;width:24px;height:2px;background:var(--neon-blue);transition:all 0.3s}

  /* ===== HERO ===== */
  #hero{
    position:relative;min-height:100vh;
    display:flex;align-items:center;justify-content:center;
    overflow:hidden;
  }
  .hero-bg{
    position:absolute;inset:0;
    background:
      radial-gradient(ellipse 80% 60% at 50% 100%, rgba(0,200,255,0.07) 0%, transparent 70%),
      radial-gradient(ellipse 60% 40% at 80% 20%, rgba(255,34,68,0.06) 0%, transparent 60%),
      linear-gradient(180deg, #020408 0%, #060c14 50%, #020408 100%);
  }
  .hero-grid{
    position:absolute;inset:0;
    background-image:
      linear-gradient(rgba(0,200,255,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0,200,255,0.04) 1px, transparent 1px);
    background-size:60px 60px;
    mask-image:radial-gradient(ellipse 100% 80% at 50% 100%, black 30%, transparent 80%);
  }
  .hero-car{
    position:absolute;bottom:0;left:50%;transform:translateX(-50%);
    width:min(900px,100%);opacity:0.22;
    filter:blur(0.5px) brightness(1.4) drop-shadow(0 0 40px rgba(0,200,255,0.4));
    animation:float 6s ease-in-out infinite;
  }
  @keyframes float{0%,100%{transform:translateX(-50%) translateY(0)}50%{transform:translateX(-50%) translateY(-12px)}}
  .hero-content{
    position:relative;z-index:2;
    text-align:center;
    padding:0 24px;
    max-width:900px;
    animation:heroIn 1.2s ease both;
  }
  @keyframes heroIn{from{opacity:0;transform:translateY(40px)}to{opacity:1;transform:translateY(0)}}
  .hero-eyebrow{
    font-family:var(--font-display);
    font-size:0.65rem;
    letter-spacing:6px;
    color:var(--neon-blue);
    text-transform:uppercase;
    margin-bottom:20px;
    opacity:0.85;
  }
  .hero-title{
    font-family:var(--font-display);
    font-size:clamp(2.4rem,6vw,5.2rem);
    font-weight:900;
    line-height:1.05;
    letter-spacing:-1px;
    margin-bottom:24px;
    background:linear-gradient(135deg,#fff 0%,#c8e8ff 40%,var(--neon-blue) 100%);
    -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
    text-shadow:none;
  }
  .hero-sub{
    font-family:var(--font-body);
    font-size:clamp(1.1rem,2.5vw,1.6rem);
    font-weight:300;
    letter-spacing:6px;
    color:var(--text-secondary);
    text-transform:uppercase;
    margin-bottom:48px;
  }
  .hero-sub span{color:var(--neon-red);font-weight:500}
  .hero-btns{display:flex;gap:16px;justify-content:center;flex-wrap:wrap}
  .btn-primary{
    padding:16px 40px;
    background:var(--neon-blue);
    color:#000;
    border:none;
    font-family:var(--font-display);
    font-size:0.72rem;
    font-weight:700;
    letter-spacing:2px;
    text-transform:uppercase;
    cursor:pointer;
    border-radius:4px;
    text-decoration:none;
    display:inline-flex;align-items:center;gap:8px;
    transition:all 0.3s;
    box-shadow:0 0 30px rgba(0,200,255,0.35);
  }
  .btn-primary:hover{box-shadow:0 0 50px rgba(0,200,255,0.6);transform:translateY(-2px)}
  .btn-outline{
    padding:16px 40px;
    background:transparent;
    color:var(--text-primary);
    border:1px solid rgba(255,255,255,0.25);
    font-family:var(--font-display);
    font-size:0.72rem;
    font-weight:600;
    letter-spacing:2px;
    text-transform:uppercase;
    cursor:pointer;
    border-radius:4px;
    text-decoration:none;
    display:inline-flex;align-items:center;gap:8px;
    transition:all 0.3s;
  }
  .btn-outline:hover{border-color:var(--neon-red);color:var(--neon-red);box-shadow:0 0 24px rgba(255,34,68,0.25);transform:translateY(-2px)}
  .btn-red{
    padding:16px 40px;
    background:var(--neon-red);
    color:#fff;
    border:none;
    font-family:var(--font-display);
    font-size:0.72rem;
    font-weight:700;
    letter-spacing:2px;
    text-transform:uppercase;
    cursor:pointer;
    border-radius:4px;
    text-decoration:none;
    display:inline-flex;align-items:center;gap:8px;
    transition:all 0.3s;
    box-shadow:0 0 30px rgba(255,34,68,0.35);
  }
  .btn-red:hover{box-shadow:0 0 50px rgba(255,34,68,0.6);transform:translateY(-2px)}
  .scroll-indicator{
    position:absolute;bottom:32px;left:50%;transform:translateX(-50%);
    display:flex;flex-direction:column;align-items:center;gap:8px;
    animation:bounce 2s ease-in-out infinite;
    opacity:0.5;
  }
  @keyframes bounce{0%,100%{transform:translateX(-50%) translateY(0)}50%{transform:translateX(-50%) translateY(8px)}}
  .scroll-indicator span{font-size:0.6rem;letter-spacing:3px;color:var(--text-dim)}
  .scroll-line{width:1px;height:40px;background:linear-gradient(to bottom,var(--neon-blue),transparent)}

  /* ===== SECTIONS ===== */
  section{position:relative;z-index:1}
  .section-header{text-align:center;margin-bottom:64px}
  .section-tag{
    font-family:var(--font-display);
    font-size:0.6rem;
    letter-spacing:5px;
    color:var(--neon-blue);
    text-transform:uppercase;
    margin-bottom:12px;
    display:block;
  }
  .section-title{
    font-family:var(--font-display);
    font-size:clamp(1.8rem,4vw,3rem);
    font-weight:700;
    letter-spacing:-0.5px;
    color:var(--text-primary);
    margin-bottom:16px;
  }
  .section-title span{color:var(--neon-blue)}
  .section-desc{
    font-family:var(--font-sub);
    font-size:1rem;
    color:var(--text-secondary);
    max-width:580px;
    margin:0 auto;
    line-height:1.7;
    font-weight:300;
  }
  .container{max-width:1280px;margin:0 auto;padding:0 32px}
  .py{padding:100px 0}

  /* ===== TICKER ===== */
  .ticker-wrap{
    background:rgba(0,200,255,0.06);
    border-top:1px solid rgba(0,200,255,0.15);
    border-bottom:1px solid rgba(0,200,255,0.15);
    overflow:hidden;padding:14px 0;
  }
  .ticker{display:flex;gap:80px;animation:ticker 28s linear infinite;width:max-content}
  @keyframes ticker{from{transform:translateX(0)}to{transform:translateX(-50%)}}
  .ticker-item{
    display:flex;align-items:center;gap:10px;
    font-family:var(--font-body);font-size:0.85rem;
    color:var(--text-secondary);white-space:nowrap;letter-spacing:1px;
  }
  .ticker-item .dot{width:6px;height:6px;border-radius:50%;background:var(--neon-blue);flex-shrink:0;box-shadow:0 0 8px var(--neon-blue)}
  .ticker-item.red .dot{background:var(--neon-red);box-shadow:0 0 8px var(--neon-red)}
  .ticker-item strong{color:var(--text-primary)}

  /* ===== VEHICLE CARDS ===== */
  .vehicles-grid{
    display:grid;
    grid-template-columns:repeat(auto-fill,minmax(360px,1fr));
    gap:28px;
  }
  .vehicle-card{
    position:relative;
    background:var(--glass);
    border:1px solid var(--glass-border);
    border-radius:var(--radius);
    overflow:hidden;
    backdrop-filter:blur(16px);
    transition:all 0.4s ease;
    cursor:pointer;
  }
  .vehicle-card:hover{
    border-color:var(--neon-blue);
    box-shadow:0 0 40px rgba(0,200,255,0.15),inset 0 0 40px rgba(0,200,255,0.03);
    transform:translateY(-6px);
  }
  .vehicle-img-wrap{
    position:relative;height:200px;overflow:hidden;
    background:linear-gradient(135deg,#0a1828,#0f2040);
  }
  .vehicle-img-wrap::after{
    content:'';position:absolute;bottom:0;left:0;right:0;height:50%;
    background:linear-gradient(to top,rgba(6,12,20,0.9),transparent);
  }
  .vehicle-img{
    width:100%;height:100%;object-fit:cover;
    transition:transform 0.6s ease;
    filter:brightness(0.9) contrast(1.1);
  }
  .vehicle-card:hover .vehicle-img{transform:scale(1.06)}
  .vehicle-badge{
    position:absolute;top:14px;right:14px;z-index:2;
    background:rgba(0,200,255,0.15);
    border:1px solid var(--neon-blue);
    color:var(--neon-blue);
    font-family:var(--font-display);
    font-size:0.55rem;
    letter-spacing:2px;
    padding:4px 10px;
    border-radius:2px;
    text-transform:uppercase;
  }
  .vehicle-badge.red{background:rgba(255,34,68,0.15);border-color:var(--neon-red);color:var(--neon-red)}
  .vehicle-body{padding:24px}
  .vehicle-name{
    font-family:var(--font-display);
    font-size:1.15rem;
    font-weight:700;
    letter-spacing:1px;
    color:var(--text-primary);
    margin-bottom:8px;
  }
  .vehicle-desc{
    font-family:var(--font-sub);
    font-size:0.82rem;
    color:var(--text-secondary);
    line-height:1.65;
    margin-bottom:20px;
    font-weight:300;
  }
  .vehicle-specs{
    display:grid;grid-template-columns:1fr 1fr;gap:12px;
    margin-bottom:20px;
  }
  .spec-item{
    background:rgba(0,200,255,0.04);
    border:1px solid rgba(0,200,255,0.1);
    border-radius:8px;
    padding:10px 12px;
  }
  .spec-label{
    font-family:var(--font-body);
    font-size:0.62rem;
    letter-spacing:2px;
    color:var(--text-dim);
    text-transform:uppercase;
    margin-bottom:4px;
  }
  .spec-value{
    font-family:var(--font-display);
    font-size:0.9rem;
    font-weight:600;
    color:var(--neon-blue);
  }
  .vehicle-footer{
    display:flex;align-items:center;justify-content:space-between;
    padding-top:16px;
    border-top:1px solid rgba(0,200,255,0.1);
  }
  .vehicle-price{
    font-family:var(--font-display);
    font-size:1.3rem;
    font-weight:700;
    color:var(--text-primary);
  }
  .btn-order{
    padding:10px 22px;
    background:transparent;
    border:1px solid var(--neon-blue);
    color:var(--neon-blue);
    font-family:var(--font-display);
    font-size:0.62rem;
    letter-spacing:2px;
    font-weight:600;
    text-transform:uppercase;
    border-radius:4px;
    cursor:pointer;
    transition:all 0.3s;
  }
  .btn-order:hover{background:var(--neon-blue);color:#000;box-shadow:0 0 20px rgba(0,200,255,0.5)}

  /* ===== GIVEAWAY ===== */
  .giveaway-grid{
    display:grid;
    grid-template-columns:repeat(auto-fill,minmax(280px,1fr));
    gap:24px;
  }
  .giveaway-card{
    background:var(--glass);
    border:1px solid rgba(255,34,68,0.18);
    border-radius:var(--radius);
    overflow:hidden;
    backdrop-filter:blur(16px);
    transition:all 0.4s;
  }
  .giveaway-card:hover{
    border-color:var(--neon-red);
    transform:translateY(-4px);
    box-shadow:0 0 32px rgba(255,34,68,0.15);
  }
  .giveaway-img{
    width:100%;height:180px;object-fit:cover;
    filter:brightness(0.75) saturate(0.8);
    transition:all 0.5s;
  }
  .giveaway-card:hover .giveaway-img{filter:brightness(0.9) saturate(1)}
  .giveaway-body{padding:22px}
  .giveaway-title{
    font-family:var(--font-display);
    font-size:0.95rem;
    font-weight:700;
    color:var(--text-primary);
    margin-bottom:8px;
    letter-spacing:0.5px;
  }
  .giveaway-desc{
    font-size:0.82rem;
    color:var(--text-secondary);
    line-height:1.6;
    margin-bottom:16px;
    font-family:var(--font-sub);
    font-weight:300;
  }
  .countdown{
    display:flex;gap:10px;margin-bottom:16px;
  }
  .cd-unit{
    flex:1;background:rgba(255,34,68,0.07);
    border:1px solid rgba(255,34,68,0.2);
    border-radius:8px;padding:8px 4px;
    text-align:center;
  }
  .cd-num{
    font-family:var(--font-display);
    font-size:1.1rem;font-weight:700;
    color:var(--neon-red);display:block;
  }
  .cd-label{
    font-size:0.5rem;letter-spacing:2px;
    color:var(--text-dim);text-transform:uppercase;
  }
  .btn-enter{
    width:100%;padding:12px;
    background:linear-gradient(135deg,rgba(255,34,68,0.15),rgba(255,34,68,0.05));
    border:1px solid var(--neon-red);
    color:var(--neon-red);
    font-family:var(--font-display);
    font-size:0.65rem;letter-spacing:2px;
    text-transform:uppercase;font-weight:600;
    border-radius:8px;cursor:pointer;
    transition:all 0.3s;
  }
  .btn-enter:hover{background:var(--neon-red);color:#fff;box-shadow:0 0 20px rgba(255,34,68,0.4)}

  /* ===== INVESTMENT ===== */
  .investment-intro{
    display:grid;grid-template-columns:1fr 1fr;gap:64px;
    align-items:center;margin-bottom:80px;
  }
  .investment-intro-text h3{
    font-family:var(--font-display);
    font-size:clamp(1.4rem,3vw,2.2rem);
    font-weight:700;
    color:var(--text-primary);
    margin-bottom:16px;
    line-height:1.2;
  }
  .investment-intro-text h3 span{color:var(--neon-blue)}
  .investment-intro-text p{
    font-family:var(--font-sub);
    font-size:0.92rem;
    color:var(--text-secondary);
    line-height:1.8;
    margin-bottom:12px;
    font-weight:300;
  }
  .invest-stat{
    display:flex;gap:32px;margin-top:28px;
  }
  .invest-stat-item{
    background:rgba(0,200,255,0.05);
    border:1px solid rgba(0,200,255,0.15);
    border-radius:12px;padding:16px 20px;flex:1;
  }
  .invest-stat-num{
    font-family:var(--font-display);
    font-size:1.4rem;font-weight:700;
    color:var(--neon-blue);
  }
  .invest-stat-label{
    font-size:0.7rem;color:var(--text-dim);
    letter-spacing:1.5px;text-transform:uppercase;margin-top:4px;
  }
  .crypto-logos{
    display:flex;gap:16px;flex-wrap:wrap;
  }
  .crypto-chip{
    display:flex;align-items:center;gap:10px;
    background:rgba(255,255,255,0.04);
    border:1px solid rgba(255,255,255,0.1);
    border-radius:40px;padding:10px 20px;
    font-family:var(--font-body);
    font-size:0.85rem;font-weight:600;
    color:var(--text-primary);
    transition:all 0.3s;
  }
  .crypto-chip:hover{border-color:var(--neon-blue);background:rgba(0,200,255,0.07)}
  .crypto-chip .icon{width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:0.9rem;font-weight:700}
  .btc-icon{background:linear-gradient(135deg,#f7931a,#e67e22);color:#fff}
  .eth-icon{background:linear-gradient(135deg,#627eea,#8a9fd0);color:#fff}
  .usdt-icon{background:linear-gradient(135deg,#26a17b,#1a7a5e);color:#fff}
  .plans-grid{
    display:grid;
    grid-template-columns:repeat(auto-fill,minmax(300px,1fr));
    gap:24px;
  }
  .plan-card{
    background:var(--glass);
    border:1px solid rgba(0,200,255,0.12);
    border-radius:var(--radius);
    padding:32px;
    backdrop-filter:blur(16px);
    transition:all 0.4s;
    position:relative;overflow:hidden;
  }
  .plan-card::before{
    content:'';position:absolute;top:0;left:0;right:0;height:3px;
    background:linear-gradient(90deg,transparent,var(--neon-blue),transparent);
    opacity:0;transition:opacity 0.4s;
  }
  .plan-card:hover::before{opacity:1}
  .plan-card.featured{
    border-color:var(--neon-blue);
    background:rgba(0,200,255,0.06);
    box-shadow:0 0 40px rgba(0,200,255,0.1);
  }
  .plan-card.featured::before{opacity:1}
  .plan-badge{
    display:inline-block;
    background:var(--neon-blue);color:#000;
    font-family:var(--font-display);
    font-size:0.55rem;letter-spacing:2px;
    padding:4px 12px;border-radius:2px;
    text-transform:uppercase;font-weight:700;
    margin-bottom:20px;
  }
  .plan-badge.red{background:var(--neon-red);color:#fff}
  .plan-badge.gold{background:var(--gold);color:#000}
  .plan-name{
    font-family:var(--font-display);
    font-size:1.3rem;font-weight:700;
    color:var(--text-primary);margin-bottom:8px;
  }
  .plan-roi{
    font-family:var(--font-display);
    font-size:2.8rem;font-weight:900;
    color:var(--neon-blue);line-height:1;
    margin-bottom:4px;
  }
  .plan-roi-label{
    font-size:0.7rem;color:var(--text-dim);
    letter-spacing:2px;text-transform:uppercase;margin-bottom:20px;
  }
  .plan-range{
    font-family:var(--font-body);
    font-size:0.9rem;color:var(--text-secondary);
    margin-bottom:8px;font-weight:500;
  }
  .plan-minimum{
    font-family:var(--font-display);
    font-size:0.7rem;
    color:var(--neon-blue);
    letter-spacing:1.5px;
    margin-bottom:20px;
    background:rgba(0,200,255,0.08);
    border:1px solid rgba(0,200,255,0.2);
    border-radius:6px;
    padding:8px 12px;
    display:inline-block;
  }
  .plan-features{list-style:none;margin-bottom:24px}
  .plan-features li{
    font-family:var(--font-sub);
    font-size:0.82rem;
    color:var(--text-secondary);
    padding:8px 0;
    border-bottom:1px solid rgba(255,255,255,0.04);
    display:flex;align-items:center;gap:10px;
  }
  .plan-features li::before{
    content:'◆';color:var(--neon-blue);
    font-size:0.5rem;flex-shrink:0;
  }
  .plan-graph{
    height:60px;margin-bottom:20px;
    background:linear-gradient(135deg,rgba(0,200,255,0.05),rgba(0,200,255,0.02));
    border-radius:8px;border:1px solid rgba(0,200,255,0.08);
    overflow:hidden;position:relative;
    display:flex;align-items:flex-end;gap:3px;padding:8px;
  }
  .graph-bar{
    flex:1;border-radius:3px 3px 0 0;
    background:linear-gradient(to top,var(--neon-blue),rgba(0,200,255,0.3));
    animation:growBar 1.5s ease both;
    min-height:4px;
  }
  @keyframes growBar{from{transform:scaleY(0);transform-origin:bottom}to{transform:scaleY(1);transform-origin:bottom}}
  .btn-invest{
    width:100%;padding:14px;
    background:linear-gradient(135deg,rgba(0,200,255,0.15),rgba(0,200,255,0.05));
    border:1px solid var(--neon-blue);
    color:var(--neon-blue);
    font-family:var(--font-display);
    font-size:0.65rem;letter-spacing:2px;
    text-transform:uppercase;font-weight:700;
    border-radius:8px;cursor:pointer;
    transition:all 0.3s;
  }
  .btn-invest:hover{background:var(--neon-blue);color:#000;box-shadow:0 0 24px rgba(0,200,255,0.4)}

  /* ===== ACTIVITY FEED ===== */
  .activity-wrapper{
    background:var(--glass);
    border:1px solid var(--glass-border);
    border-radius:var(--radius);
    overflow:hidden;
    backdrop-filter:blur(16px);
    height:320px;
    position:relative;
  }
  .activity-header{
    padding:20px 24px;
    border-bottom:1px solid rgba(0,200,255,0.1);
    display:flex;align-items:center;justify-content:space-between;
  }
  .activity-title{
    font-family:var(--font-display);
    font-size:0.8rem;font-weight:600;letter-spacing:2px;
    color:var(--text-primary);
  }
  .live-dot{
    display:flex;align-items:center;gap:8px;
    font-size:0.65rem;letter-spacing:2px;color:var(--neon-blue);
  }
  .live-dot::before{
    content:'';width:6px;height:6px;border-radius:50%;
    background:var(--neon-blue);
    animation:pulse 2s ease-in-out infinite;
  }
  @keyframes pulse{0%,100%{opacity:1;box-shadow:0 0 0 0 rgba(0,200,255,0.4)}50%{opacity:0.7;box-shadow:0 0 0 8px rgba(0,200,255,0)}}
  .activity-feed{
    overflow:hidden;height:calc(100% - 65px);
  }
  .activity-scroll{
    display:flex;flex-direction:column;
    animation:feedScroll 20s linear infinite;
  }
  @keyframes feedScroll{0%{transform:translateY(0)}100%{transform:translateY(-50%)}}
  .activity-item{
    display:flex;align-items:center;gap:14px;
    padding:14px 24px;
    border-bottom:1px solid rgba(255,255,255,0.03);
  }
  .activity-icon{
    width:36px;height:36px;border-radius:50%;
    display:flex;align-items:center;justify-content:center;
    font-size:1rem;flex-shrink:0;
  }
  .activity-icon.invest{background:rgba(0,200,255,0.1);border:1px solid rgba(0,200,255,0.2)}
  .activity-icon.purchase{background:rgba(0,255,120,0.1);border:1px solid rgba(0,255,120,0.2)}
  .activity-icon.giveaway{background:rgba(255,34,68,0.1);border:1px solid rgba(255,34,68,0.2)}
  .activity-text{
    font-family:var(--font-sub);font-size:0.82rem;
    color:var(--text-secondary);flex:1;
    font-weight:300;line-height:1.4;
  }
  .activity-text strong{color:var(--text-primary);font-weight:500}
  .activity-time{
    font-size:0.65rem;color:var(--text-dim);
    letter-spacing:1px;white-space:nowrap;
  }

  /* ===== PRODUCTS ===== */
  .products-grid{
    display:grid;
    grid-template-columns:repeat(auto-fill,minmax(300px,1fr));
    gap:24px;
  }
  .product-card{
    background:var(--glass);
    border:1px solid var(--glass-border);
    border-radius:var(--radius);
    overflow:hidden;
    backdrop-filter:blur(16px);
    transition:all 0.4s;
  }
  .product-card:hover{
    border-color:var(--neon-blue);
    transform:translateY(-4px);
    box-shadow:0 0 32px rgba(0,200,255,0.12);
  }
  .product-img{width:100%;height:200px;object-fit:cover;filter:brightness(0.8);transition:all 0.5s}
  .product-card:hover .product-img{filter:brightness(1);transform:scale(1.03)}
  .product-body{padding:22px}
  .product-name{
    font-family:var(--font-display);
    font-size:1rem;font-weight:700;
    color:var(--text-primary);margin-bottom:8px;
  }
  .product-desc{
    font-family:var(--font-sub);font-size:0.82rem;
    color:var(--text-secondary);line-height:1.6;
    margin-bottom:16px;font-weight:300;
  }
  .product-footer{
    display:flex;align-items:center;justify-content:space-between;
    padding-top:14px;border-top:1px solid rgba(0,200,255,0.08);
  }
  .product-price{
    font-family:var(--font-display);
    font-size:1.1rem;font-weight:700;color:var(--text-primary);
  }

  /* ===== AUTH MODAL ===== */
  .modal-overlay{
    position:fixed;inset:0;
    background:rgba(0,0,0,0.85);
    backdrop-filter:blur(12px);
    z-index:2000;
    display:none;align-items:center;justify-content:center;
  }
  .modal-overlay.active{display:flex}
  .modal{
    background:var(--bg-card);
    border:1px solid var(--glass-border);
    border-radius:24px;
    padding:40px;
    width:min(460px,95vw);
    position:relative;
    animation:modalIn 0.4s ease both;
  }
  @keyframes modalIn{from{opacity:0;transform:scale(0.92) translateY(20px)}to{opacity:1;transform:scale(1) translateY(0)}}
  .modal-close{
    position:absolute;top:20px;right:20px;
    width:32px;height:32px;border-radius:50%;
    background:rgba(255,255,255,0.05);
    border:1px solid rgba(255,255,255,0.1);
    color:var(--text-secondary);
    font-size:1rem;cursor:pointer;
    display:flex;align-items:center;justify-content:center;
    transition:all 0.3s;
  }
  .modal-close:hover{background:var(--neon-red);border-color:var(--neon-red);color:#fff}
  .modal-logo{text-align:center;margin-bottom:28px}
  .modal-title{
    font-family:var(--font-display);
    font-size:1.4rem;font-weight:700;
    text-align:center;color:var(--text-primary);
    margin-bottom:8px;
  }
  .modal-sub{
    font-size:0.82rem;color:var(--text-secondary);
    text-align:center;margin-bottom:28px;
  }
  .modal-tabs{
    display:flex;gap:0;
    background:rgba(0,0,0,0.3);
    border-radius:8px;padding:4px;
    margin-bottom:28px;
  }
  .modal-tab{
    flex:1;padding:10px;
    background:transparent;
    border:none;
    font-family:var(--font-display);
    font-size:0.7rem;letter-spacing:2px;
    text-transform:uppercase;font-weight:600;
    color:var(--text-dim);
    border-radius:6px;cursor:pointer;
    transition:all 0.3s;
  }
  .modal-tab.active{background:var(--neon-blue);color:#000}
  .form-group{margin-bottom:16px}
  .form-label{
    display:block;
    font-family:var(--font-body);
    font-size:0.7rem;letter-spacing:2px;
    color:var(--text-dim);text-transform:uppercase;
    margin-bottom:6px;
  }
  .form-input{
    width:100%;padding:12px 16px;
    background:rgba(255,255,255,0.04);
    border:1px solid rgba(255,255,255,0.08);
    border-radius:8px;
    color:var(--text-primary);
    font-family:var(--font-sub);font-size:0.9rem;
    outline:none;transition:all 0.3s;
  }
  .form-input:focus{border-color:var(--neon-blue);background:rgba(0,200,255,0.04);box-shadow:0 0 0 3px rgba(0,200,255,0.1)}
  .btn-full{
    width:100%;padding:14px;
    background:var(--neon-blue);color:#000;
    border:none;
    font-family:var(--font-display);
    font-size:0.72rem;letter-spacing:2px;
    font-weight:700;text-transform:uppercase;
    border-radius:8px;cursor:pointer;
    transition:all 0.3s;margin-top:8px;
  }
  .btn-full:hover{box-shadow:0 0 24px rgba(0,200,255,0.5)}

  /* ===== DASHBOARD ===== */
  .dashboard-preview{
    background:var(--glass);
    border:1px solid var(--glass-border);
    border-radius:var(--radius);
    padding:28px;
    backdrop-filter:blur(16px);
  }
  .dashboard-header{
    display:flex;align-items:center;justify-content:space-between;
    margin-bottom:28px;
  }
  .dash-title{
    font-family:var(--font-display);
    font-size:1rem;font-weight:700;color:var(--text-primary);
  }
  .dashboard-stats{
    display:grid;grid-template-columns:repeat(4,1fr);gap:16px;
    margin-bottom:24px;
  }
  .dash-stat{
    background:rgba(0,200,255,0.05);
    border:1px solid rgba(0,200,255,0.12);
    border-radius:12px;padding:16px;text-align:center;
  }
  .dash-stat-num{
    font-family:var(--font-display);
    font-size:1.3rem;font-weight:700;color:var(--neon-blue);
  }
  .dash-stat-label{
    font-size:0.62rem;color:var(--text-dim);
    letter-spacing:2px;text-transform:uppercase;margin-top:4px;
  }

  /* ===== FOOTER ===== */
  footer{
    background:rgba(2,4,8,0.95);
    border-top:1px solid rgba(0,200,255,0.08);
    padding:60px 0 32px;
  }
  .footer-grid{
    display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:40px;
    margin-bottom:48px;
  }
  .footer-brand .logo{margin-bottom:16px}
  .footer-brand p{
    font-family:var(--font-sub);
    font-size:0.82rem;color:var(--text-dim);
    line-height:1.7;font-weight:300;max-width:280px;
  }
  .footer-col h4{
    font-family:var(--font-display);
    font-size:0.7rem;font-weight:600;
    letter-spacing:2px;color:var(--text-primary);
    text-transform:uppercase;margin-bottom:20px;
  }
  .footer-col ul{list-style:none}
  .footer-col ul li{margin-bottom:10px}
  .footer-col ul li a{
    font-family:var(--font-sub);
    font-size:0.82rem;color:var(--text-dim);
    text-decoration:none;transition:color 0.3s;font-weight:300;
  }
  .footer-col ul li a:hover{color:var(--neon-blue)}
  .footer-bottom{
    border-top:1px solid rgba(255,255,255,0.05);
    padding-top:28px;
    display:flex;align-items:center;justify-content:space-between;
    flex-wrap:wrap;gap:16px;
  }
  .footer-legal{
    font-family:var(--font-sub);
    font-size:0.75rem;color:var(--text-dim);
    font-weight:300;
  }
  .footer-legal span{color:var(--neon-red)}

  /* ===== BOTTOM NAV (MOBILE) ===== */
  .bottom-nav{
    display:none;
    position:fixed;bottom:0;left:0;right:0;z-index:900;
    background:rgba(2,4,8,0.92);
    backdrop-filter:blur(20px);
    border-top:1px solid rgba(0,200,255,0.15);
    padding:10px 0 calc(10px + env(safe-area-inset-bottom));
  }
  .bottom-nav-items{
    display:flex;justify-content:space-around;align-items:center;
  }
  .bn-item{
    display:flex;flex-direction:column;align-items:center;gap:4px;
    padding:6px 12px;cursor:pointer;
    font-family:var(--font-body);
    font-size:0.55rem;letter-spacing:1.5px;
    color:var(--text-dim);text-transform:uppercase;
    text-decoration:none;transition:color 0.3s;
  }
  .bn-item.active,.bn-item:hover{color:var(--neon-blue)}
  .bn-icon{font-size:1.2rem}

  /* ===== ANIMATIONS ===== */
  .fade-up{
    opacity:0;transform:translateY(30px);
    transition:opacity 0.7s ease,transform 0.7s ease;
  }
  .fade-up.visible{opacity:1;transform:translateY(0)}
  .stagger-1{transition-delay:0.1s}
  .stagger-2{transition-delay:0.2s}
  .stagger-3{transition-delay:0.3s}
  .stagger-4{transition-delay:0.4s}
  .stagger-5{transition-delay:0.5s}
  .stagger-6{transition-delay:0.6s}

  /* DIVIDER */
  .divider{
    height:1px;
    background:linear-gradient(90deg,transparent,rgba(0,200,255,0.3),transparent);
    margin:0;
  }

  /* SECTION BG */
  .bg-alt{background:rgba(4,10,20,0.6)}

  /* NOTIFICATION */
  .notification{
    position:fixed;top:90px;right:24px;
    background:var(--glass);
    border:1px solid rgba(0,200,255,0.3);
    border-radius:12px;
    padding:14px 20px;
    display:flex;align-items:center;gap:12px;
    font-family:var(--font-body);
    font-size:0.85rem;color:var(--text-primary);
    z-index:3000;
    transform:translateX(120%);
    transition:transform 0.4s ease;
    backdrop-filter:blur(16px);
    box-shadow:0 0 30px rgba(0,200,255,0.15);
    max-width:320px;
  }
  .notification.show{transform:translateX(0)}
  .notif-icon{font-size:1.2rem}

  @media(max-width:1024px){
    .investment-intro{grid-template-columns:1fr}
    .footer-grid{grid-template-columns:1fr 1fr}
    .dashboard-stats{grid-template-columns:repeat(2,1fr)}
  }
  @media(max-width:768px){
    nav{padding:14px 20px}
    .nav-links,.nav-cta{display:none}
    .hamburger{display:flex}
    .vehicles-grid{grid-template-columns:1fr}
    .giveaway-grid{grid-template-columns:1fr 1fr}
    .plans-grid{grid-template-columns:1fr}
    .footer-grid{grid-template-columns:1fr}
    .bottom-nav{display:block}
    .py{padding:70px 0 100px}
    .container{padding:0 16px}
    .hero-btns{flex-direction:column;align-items:center}
    .btn-primary,.btn-outline,.btn-red{width:100%;max-width:280px;justify-content:center}
    .dashboard-stats{grid-template-columns:1fr 1fr}
  }
  @media(max-width:480px){
    .giveaway-grid{grid-template-columns:1fr}
    .products-grid{grid-template-columns:1fr}
    .vehicles-grid{grid-template-columns:1fr}
  }
</style>
</head>
<body>

