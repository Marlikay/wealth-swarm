</nav>

<!-- HERO -->
<section id="hero">
  <div class="hero-bg"></div>
  <div class="hero-grid"></div>

  <!-- SVG Cybertruck silhouette -->
  <svg class="hero-car" viewBox="0 0 900 300" xmlns="http://www.w3.org/2000/svg">
